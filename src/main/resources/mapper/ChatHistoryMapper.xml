<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai.examples.chatbot.dao.mapper.ChatHistoryMapper">

    <select id="findBySessionIdOrderByCreateTimeAsc" resultType="com.ai.examples.chatbot.dao.entity.ChatHistory">
        SELECT id, session_id, role, content, create_time
        FROM chat_history
        WHERE session_id = #{sessionId}
        ORDER BY create_time ASC
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM chat_history WHERE session_id = #{sessionId}
    </delete>

</mapper>
